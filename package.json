{
  "name": "pms-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "PMS-FE",
    "PMS-BE"
  ],
  "scripts": {
    "fe:dev": "npm --prefix PMS-FE run dev",
    "fe:build": "npm --prefix PMS-FE run build",
    "fe:lint": "npm --prefix PMS-FE run lint",
    "fe:preview": "npm --prefix PMS-FE run preview",
    "be:dev": "npm --prefix PMS-BE run dev",
    "be:build": "npm --prefix PMS-BE run build",
    "be:start": "npm --prefix PMS-BE run start",
    "be:prisma:generate": "npm --prefix PMS-BE run prisma:generate",
    "be:prisma:migrate": "npm --prefix PMS-BE run prisma:migrate",
    "build": "npm run fe:build && npm run be:build"
  },
  "dependencies": {
    "react-helmet-async": "^3.0.0"
  }
}
